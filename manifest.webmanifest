{
  "id": "/",
  "name": "MeRun-MeTrail · L'ascension",
  "short_name": "MeRun",
  "description": "Plan Marathon de Paris 2027 sur 26 semaines (5 oct. 2026 - 4 avr. 2027) : séances détaillées avec allures calculées sur ta vitesse critique, export des séances vers une montre Garmin (.fit), PPG chronométrée, plan adaptatif selon ton ressenti et ton mood, objectif, profil coureur et visuel de semaine partageable.",
  "lang": "fr",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui",
    "browser"
  ],
  "orientation": "portrait",
  "background_color": "#0a0e14",
  "theme_color": "#0a0e14",
